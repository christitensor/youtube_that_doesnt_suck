# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# The playlist ID you use as your "Watch Later" queue.
# Must be Public or Unlisted so the API key can read it (Google's real
# Watch Later playlist isn't accessible via the API, so create a normal
# playlist and add videos to it instead).
WATCH_LATER_PLAYLIST_ID=

# Long random string - keep secret. Used to build your private podcast
# RSS feed URL: https://your-app/feed/<this value>.xml
FEED_TOKEN=changeme-generate-a-long-random-string

# Where downloaded media files are stored (should be a persistent volume in prod)
MEDIA_DIR=./data/media

# Path to the sqlite db file
DB_PATH=./data/app.db

# Public base URL of this deployed backend (used to build absolute URLs
# in the RSS feed and for the frontend to know where to call)
PUBLIC_BASE_URL=http://localhost:8080

PORT=8080

# How often to auto-sync the playlist + run podcast detection, in minutes
SYNC_INTERVAL_MINUTES=15
